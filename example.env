# Copiar este archivo como .env y reemplazar los valores de ejemplo.
# Nunca subir el .env al repositorio.

# LLM providers
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# llm provider para embeddings (gemini, openai, local)
LLM_PROVIDER=gemini
# llm provider por defecto para generación (gemini, openai, anthropic, local)
GENERATION_LLM_PROVIDER=gemini

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# llm params
LLM_TEMPERATURE=0.1
RETRIEVER_K=5

# puertos de los servicios en el equipo (el frontend espera 8001 y 8081)
RAG_SERVICE_PORT=8001
USER_SERVICE_PORT=8081

# base vectorial (rag-db)
DB_RAG=requirements_db
DB_RAG_USER=admin
DB_RAG_PASSWORD=change-me
DB_RAG_PORT=5433

# base de usuarios (users-db)
DB_USERS=users_db
DB_USERS_USER=admin
DB_USERS_PASSWORD=change-me
DB_USERS_PORT=5434

# host de las bases al ejecutar fuera de Docker (notebooks)
POSTGRES_HOST=localhost

# conexión usada por los notebooks de testing/
POSTGRES_PORT=5433
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=requirements_db

# jwt (users-service)
# JWT_SECRET debe tener al menos 32 caracteres; se puede generar con: openssl rand -hex 32
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-chars
# duración de la sesión en milisegundos (1 día)
JWT_EXPIRATION=86400000

# cache
CACHE_TTL_SECONDS=86400
